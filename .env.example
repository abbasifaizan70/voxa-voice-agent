# Server-only. Never use a VITE_ prefix for secrets.
AI_PROVIDER=groq
# Create a key at https://console.groq.com/keys. Free-tier usage limits apply.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional: set AI_PROVIDER=openai to use the assignment's original OpenAI pipeline.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
TRANSCRIPTION_MODEL=whisper-1
TTS_MODEL=gpt-4o-mini-tts
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Set NODE_ENV=production for npm start after building.
NODE_ENV=development
